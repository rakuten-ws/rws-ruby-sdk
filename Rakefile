require 'bundler/gem_tasks'
require 'rspec/core/rake_task'

task :endpoints do
  require 'rakuten_web_service'
  require 'terminal-table'

  table = Terminal::Table.new(headings: %w[Resource Endpoint]) do |t|
    RakutenWebService::Resource.subclasses.each do |resource|
      t << [resource.name, resource.endpoint] unless resource.endpoint.nil?
    end
  end

  puts table
end

namespace :sig do
  ATTRIBUTES_SIG = 'sig/generated/attributes.rbs'

  # Builds RBS declarations for the reader methods that `Resource.attribute`
  # defines dynamically, so they are visible to type checkers.
  def attributes_sig
    require 'rakuten_web_service'

    resource_file = File.expand_path('lib/rakuten_web_service/resource.rb', __dir__)
    resource_classes = ObjectSpace.each_object(Class).select { |klass| klass < RakutenWebService::Resource }

    sig = +"# This file is generated by `rake sig:generate`. Do not edit it by hand.\n"
    resource_classes.sort_by(&:name).each do |klass|
      # Skip methods overridden by a hand-written definition; those are
      # declared in the hand-written signatures.
      method_names = klass.attribute_methods.uniq.select do |method_name|
        klass.instance_method(method_name).source_location&.first == resource_file
      end
      next if method_names.empty?

      sig << "\nclass #{klass.name} < #{klass.superclass.name}\n"
      method_names.each do |method_name|
        return_type = method_name.end_with?('?') ? 'bool' : 'untyped'
        sig << "  def #{method_name}: () -> #{return_type}\n"
      end
      sig << "end\n"
    end
    sig
  end

  desc "Generate #{ATTRIBUTES_SIG} from the attributes declared in resources"
  task :generate do
    FileUtils.mkdir_p(File.dirname(ATTRIBUTES_SIG))
    File.write(ATTRIBUTES_SIG, attributes_sig)
  end

  desc "Check that #{ATTRIBUTES_SIG} is up to date"
  task :check do
    unless File.exist?(ATTRIBUTES_SIG) && File.read(ATTRIBUTES_SIG) == attributes_sig
      abort "#{ATTRIBUTES_SIG} is outdated. Run `rake sig:generate`."
    end
  end
end

RSpec::Core::RakeTask.new do |t|
  t.pattern = 'spec/**/*_spec.rb'
  t.rspec_opts = '-c -fd'
end

task :rspec => :spec
task :default => :spec
