module RakutenWebService
  module Ichiba
    # An item in Rakuten Ichiba.
    #
    # Reader methods for its attributes (e.g. `#name`, `#price`, `#image?`) are
    # declared in sig/generated/attributes.rbs.
    class Item < Resource
      # Returns the ranking search for items.
      def self.ranking: (?Hash[Symbol | String, untyped] options) -> SearchResult

      def self.genre_class: () -> singleton(Genre)

      def genre: () -> Genre

      def shop: () -> Shop
    end
  end
end
